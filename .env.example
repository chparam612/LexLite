# ==============================================================================
# LEGAL AI — ASSISTANCE & ACCESS: Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit the real .env file or real secrets to version control.
# ==============================================================================

# Application Environment
APPLICATION_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL + pgvector)
# For local dev without PostgreSQL, SQLite fallback can be used by setting:
# DATABASE_URL=sqlite:///./legal_ai_dev.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_ai_db
POSTGRES_PORT=5432

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Cloud Platform & Storage Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=legal-ai-documents-storage
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/uploads

# Gemini AI API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_GENERATION_MODEL=models/gemini-1.5-flash
RERANKER_MODEL=models/text-embedding-004

# Document Processing & RAG Pipeline Configuration
MAX_UPLOAD_SIZE_MB=25
DENSE_TOP_K=30
KEYWORD_TOP_K=30
FUSION_TOP_K=40
RERANK_TOP_K=10
FINAL_CONTEXT_CHUNKS=8
MAX_CONTEXT_TOKENS=12000
PARENT_CONTEXT_ENABLED=true
CITATION_VERIFICATION_ENABLED=true

# Security & CORS
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
